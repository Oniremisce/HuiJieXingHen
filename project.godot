; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="汇界星痕"
run/main_scene="res://scenes/map/CampMap.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"
Dialogic="*uid://ds2q0uclmolvu"
DataManager="*uid://dhkkxbvd8pcwy"
EventBus="*res://scripts/core/EventBus.gd"
GameState="*res://scripts/core/GameState.gd"
Party="*res://scripts/core/Party.gd"
ArtProvider="*res://scripts/core/ArtProvider.gd"
PauseManager="*res://scripts/core/PauseManager.gd"
Transition="*res://scripts/core/Transition.gd"
MapSystem="*res://scripts/core/MapSystem.gd"
ShrineSystem="*res://scripts/core/ShrineSystem.gd"
SaveManager="*res://scripts/core/SaveManager.gd"
UISystem="*res://scripts/core/UISystem.gd"
DialogicBridge="*res://scripts/dialogue/DialogicBridge.gd"

[dialogic]

directories/dch_directory={
"awakened_arcane_01": "res://dialogues/characters/awakened_arcane_01.dch",
"awakened_mech_01": "res://dialogues/characters/awakened_mech_01.dch",
"awakened_xian_01": "res://dialogues/characters/awakened_xian_01.dch",
"test_npc": "res://dialogues/characters/test_npc.dch"
}
directories/dtl_directory={
"main_01": "res://dialogues/timelines/main_01.dtl",
"npc_chat_01": "res://dialogues/timelines/npc_chat_01.dtl",
"smoke_bridge": "res://dialogues/timelines/smoke_bridge.dtl",
"smoke_test": "res://dialogues/timelines/smoke_test.dtl"
}
layout/style_directory={}
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
variables={}
layout/style_list=[]
layout/default_style="Default"
glossary/default_case_sensitive=true

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/godot_mcp_toolkit/plugin.cfg")

